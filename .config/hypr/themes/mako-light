# Mako — Nord Light (matches Waybar)

anchor=top-right
margin=20
padding=15

width=350
height=150

background-color=#ECEFF4
text-color=#2E3440
border-color=#5E81AC
border-size=2
border-radius=6

progress-color=over #5E81AC

font=JetBrains Mono 11
format=<b>%s</b>\n%b
text-alignment=left

icon-path=/usr/share/icons/Papirus-Light
max-icon-size=64
icon-location=left

sort=-time
layer=overlay
default-timeout=5000
ignore-timeout=0
max-visible=5
history=1

group-by=app-name

[urgency=low]
border-color=#5E81AC
default-timeout=3000

[urgency=normal]
border-color=#5E81AC
default-timeout=5000

[urgency=critical]
border-color=#BF616A
text-color=#BF616A
default-timeout=0

[app-name="volume"]
border-color=#5E81AC
default-timeout=2000

[app-name="brightness"]
border-color=#5E81AC
default-timeout=2000

[app-name="battery"]
border-color=#BF616A
default-timeout=8000

[app-name="theme"]
border-color=#5E81AC
default-timeout=2500
